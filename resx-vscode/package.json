{
  "name": "resx-vscode",
  "displayName": "RESX Binary Viewer",
  "description": "VS Code PE and Windows binary analysis viewer for EXE, DLL, and SYS files powered by RESX",
  "version": "1.4.0",
  "publisher": "titan-softwork-solutions",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/TITAN-Softwork-Solutions/RESX.git"
  },
  "homepage": "https://github.com/TITAN-Softwork-Solutions/RESX",
  "bugs": {
    "url": "https://github.com/TITAN-Softwork-Solutions/RESX/issues"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "Debuggers", "Visualization"],
  "keywords": [
    "resx",
    "pe",
    "portable executable",
    "windows",
    "binary analysis",
    "reverse engineering",
    "malware analysis",
    "dll",
    "exe",
    "sys",
    "pdb",
    "disassembly"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "resx.binaryViewer",
        "displayName": "RESX Binary Viewer",
        "selector": [
          { "filenamePattern": "*.exe" },
          { "filenamePattern": "*.dll" },
          { "filenamePattern": "*.sys" }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "RESX",
      "properties": {
        "resx.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "User-level path to a trusted resx.exe override. If empty, the extension uses the bundled binary."
        },
        "resx.allowCustomExecutable": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Allow a user-configured resx.executablePath override. Disabled by default so the extension only runs the bundled trusted binary."
        },
        "resx.loadSymbolsOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically load PDB symbols when opening a binary. Can be slow for large symbol stores."
        },
        "resx.symbolPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional symbol search paths passed to --sym-path."
        },
        "resx.pdbFile": {
          "type": "string",
          "default": "",
          "description": "Explicit PDB file to load, passed to --pdb."
        }
      }
    },
    "commands": [
      {
        "command": "resx.refreshBinary",
        "category": "RESX",
        "title": "Refresh Binary Analysis",
        "icon": "$(refresh)"
      },
      {
        "command": "resx.locate",
        "category": "RESX",
        "title": "Locate"
      },
      {
        "command": "resx.locateSymbol",
        "category": "RESX",
        "title": "Locate Symbol"
      },
      {
        "command": "resx.dump",
        "category": "RESX",
        "title": "Dump"
      },
      {
        "command": "resx.reconstructCfg",
        "category": "RESX",
        "title": "Reconstruct CFG"
      },
      {
        "command": "resx.scan",
        "category": "RESX",
        "title": "Scan Folder"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:webview && tsc -p ./",
    "compile:webview": "tsc -p ./tsconfig.webview.json",
    "test:webview": "npm run compile:webview && node --experimental-default-type=module ./test/run-tests.mjs",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package",
    "publish:vsce": "npx --yes @vscode/vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
