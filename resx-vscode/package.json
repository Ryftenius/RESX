{
  "name": "resx-vscode",
  "displayName": "RESX Binary Viewer",
  "description": "Windows PE analysis in VS Code powered by RESX: disassembly, call maps, CFGs, behavior triage, API contracts, drivers and IOCTLs, strings, entropy, YARA, diff and corpus hunting for EXE, DLL, SYS and PE-style BIN files",
  "version": "2.3.0",
  "publisher": "ryftenius",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ryftenius/RESX.git"
  },
  "homepage": "https://github.com/Ryftenius/RESX",
  "bugs": {
    "url": "https://github.com/Ryftenius/RESX/issues"
  },
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other",
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "resx",
    "pe",
    "portable executable",
    "windows",
    "binary analysis",
    "reverse engineering",
    "malware analysis",
    "dll",
    "exe",
    "sys",
    "pdb",
    "disassembly",
    "yara",
    "ioctl",
    "driver",
    "diff"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "resx.binaryViewer",
        "displayName": "RESX Binary Viewer",
        "selector": [
          {
            "filenamePattern": "*.exe"
          },
          {
            "filenamePattern": "*.dll"
          },
          {
            "filenamePattern": "*.sys"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "resx.binaryViewer.bin",
        "displayName": "RESX Binary Viewer",
        "selector": [
          {
            "filenamePattern": "*.bin"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "RESX",
      "properties": {
        "resx.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "User-level path to a trusted resx.exe override. If empty, the extension uses the bundled binary."
        },
        "resx.allowCustomExecutable": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Allow a user-configured resx.executablePath override. Disabled by default so the extension only runs the bundled trusted binary."
        },
        "resx.loadSymbolsOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically load PDB symbols when opening a binary. Can be slow for large symbol stores."
        },
        "resx.symbolPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional symbol search paths, joined with \";\" and passed as --sym-path."
        },
        "resx.pdbFile": {
          "type": "string",
          "default": "",
          "description": "Explicit PDB passed as --pdb for the image opened in the viewer (not for other modules reached by navigation)."
        },
        "resx.symbolServer": {
          "type": "string",
          "default": "",
          "description": "Symbol server URL passed as --sym-server (for example https://msdl.microsoft.com/download/symbols)."
        },
        "resx.imagePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra image lookup directories passed as --path, used when navigating into imported modules and by Locate/Dump pickers."
        },
        "resx.apiArguments": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Recover API call arguments (`--args`) in dumps, call maps, behavior and evidence reports. Uses the Windows SDK headers saved with **RESX: Configure Windows SDK Headers** when available. Can be toggled per viewer."
        },
        "resx.useSdkHeaders": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Use the configured Windows SDK headers for argument enrichment. When off, `--no-headers` is passed."
        },
        "resx.hostile": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Start viewers in hostile mode (`--hostile`): register slices, decoder-driven xref scans and suspicion annotations. Can be toggled per viewer."
        },
        "resx.callDepth": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 8,
          "description": "Default API call-map depth for dumps (--calls N)."
        },
        "resx.maxInstructions": {
          "type": "integer",
          "default": 500,
          "minimum": 0,
          "markdownDescription": "Per-function instruction budget (`--max-insns`). `0` means unlimited."
        },
        "resx.scanMaxFiles": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "description": "Maximum images inventoried by Scan Folder (--max-files)."
        },
        "resx.timeoutSeconds": {
          "type": "integer",
          "default": 120,
          "minimum": 10,
          "maximum": 3600,
          "description": "Seconds before a RESX process is stopped. Raise this for very large images or corpora."
        }
      }
    },
    "commands": [
      {
        "command": "resx.openBinaryFile",
        "category": "RESX",
        "title": "Open Binary File"
      },
      {
        "command": "resx.refreshBinary",
        "category": "RESX",
        "title": "Refresh Binary Analysis",
        "icon": "$(refresh)"
      },
      {
        "command": "resx.locate",
        "category": "RESX",
        "title": "Locate Export"
      },
      {
        "command": "resx.locateSymbol",
        "category": "RESX",
        "title": "Locate Symbol"
      },
      {
        "command": "resx.dump",
        "category": "RESX",
        "title": "Dump Function"
      },
      {
        "command": "resx.behavior",
        "category": "RESX",
        "title": "Behavior Triage"
      },
      {
        "command": "resx.evidence",
        "category": "RESX",
        "title": "API Contract Evidence"
      },
      {
        "command": "resx.strings",
        "category": "RESX",
        "title": "Strings"
      },
      {
        "command": "resx.entropy",
        "category": "RESX",
        "title": "Entropy"
      },
      {
        "command": "resx.driver",
        "category": "RESX",
        "title": "Driver and IOCTL Analysis"
      },
      {
        "command": "resx.search",
        "category": "RESX",
        "title": "Find, YARA and Compare"
      },
      {
        "command": "resx.reconstructCfg",
        "category": "RESX",
        "title": "Reconstruct Startup Flow"
      },
      {
        "command": "resx.diff",
        "category": "RESX",
        "title": "Compare Images (Diff)"
      },
      {
        "command": "resx.scan",
        "category": "RESX",
        "title": "Scan Folder"
      },
      {
        "command": "resx.index",
        "category": "RESX",
        "title": "Index Folder as Corpus"
      },
      {
        "command": "resx.hunt",
        "category": "RESX",
        "title": "Find Similar Images in Corpus"
      },
      {
        "command": "resx.payload",
        "category": "RESX",
        "title": "Decode Payload"
      },
      {
        "command": "resx.patch",
        "category": "RESX",
        "title": "Patch Image Bytes"
      },
      {
        "command": "resx.apiLookup",
        "category": "RESX",
        "title": "Look Up Windows API Prototype"
      },
      {
        "command": "resx.configureHeaders",
        "category": "RESX",
        "title": "Configure Windows SDK Headers"
      },
      {
        "command": "resx.showVersion",
        "category": "RESX",
        "title": "Show Analyzer Version"
      },
      {
        "command": "resx.openSettings",
        "category": "RESX",
        "title": "Open Settings"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "resx.openBinaryFile",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(exe|dll|sys|bin|efi|scr|cpl|ocx|drv)$/i",
          "group": "navigation@10"
        },
        {
          "command": "resx.behavior",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(exe|dll|sys|bin|efi|scr|cpl|ocx|drv)$/i",
          "group": "resx@1"
        },
        {
          "command": "resx.driver",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.sys$/i",
          "group": "resx@2"
        },
        {
          "command": "resx.diff",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(exe|dll|sys|bin|efi|scr|cpl|ocx|drv)$/i && listMultiSelection",
          "group": "resx@3"
        },
        {
          "command": "resx.hunt",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(exe|dll|sys|bin|efi|scr|cpl|ocx|drv)$/i && !listMultiSelection",
          "group": "resx@4"
        },
        {
          "command": "resx.patch",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(exe|dll|sys|bin|efi|scr|cpl|ocx|drv)$/i && !listMultiSelection",
          "group": "resx@5"
        },
        {
          "command": "resx.payload",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "resx@6"
        },
        {
          "command": "resx.scan",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "resx@7"
        },
        {
          "command": "resx.index",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "resx@8"
        }
      ],
      "editor/title": [
        {
          "command": "resx.refreshBinary",
          "when": "activeCustomEditorId == 'resx.binaryViewer' || activeCustomEditorId == 'resx.binaryViewer.bin'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "resx.refreshBinary",
          "when": "activeCustomEditorId == 'resx.binaryViewer' || activeCustomEditorId == 'resx.binaryViewer.bin'"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:webview && tsc -p ./",
    "compile:webview": "node ./scripts/sync-webview-shared.mjs && tsc -p ./tsconfig.webview.json",
    "test": "npm run compile && node ./test/run-tests.mjs",
    "test:webview": "npm run compile:webview && node ./test/run-tests.mjs",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package",
    "publish:vsce": "npx --yes @vscode/vsce publish"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/vscode": "^1.137.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "glob": "^14.0.2",
    "qs": "^6.16.1",
    "@vscode/vsce": {
      "@azure/identity": "4.13.0"
    },
    "@azure/msal-node": {
      "uuid": "11.1.1"
    }
  }
}
