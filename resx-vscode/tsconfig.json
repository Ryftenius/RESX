{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2020",
    "outDir": "./out",
    "lib": ["ES2020"],
    "sourceMap": true,
    "removeComments": true,
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node", "vscode"]
  },
  "exclude": ["node_modules", ".vscode-test", "media-src"]
}
